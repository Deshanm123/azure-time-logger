{
  "name": "@time-logger/extension",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --coverage",
    "package:extension": "npm run build && tfx extension create --manifest-globs vss-extension.json"
  },
  "dependencies": {
    "@time-logger/contracts": "0.1.0",
    "azure-devops-extension-api": "^4.260.0",
    "azure-devops-extension-sdk": "^5.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^27.0.0",
    "tfx-cli": "^0.24.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}
