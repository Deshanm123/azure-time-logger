NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://time_logger:time_logger_dev@localhost:5433/time_logger?schema=public
AUTH_MODE=development-headers
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_HOURS_PER_ENTRY=24
BUSINESS_TIME_ZONE=UTC

# Production only: the certificate key from the Azure DevOps extension portal.
# AUTH_MODE=app-token
# EXTENSION_SECRET=replace-through-a-secret-store

# Recommended production authentication. These are public identifiers, not secrets.
# AUTH_MODE=entra
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# ENTRA_REQUIRED_SCOPE=access_as_user
